generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// User & Authentication Module
// ==========================================

model Role {
  role_id   Int    @id @default(autoincrement())
  role_name String @unique @db.VarChar(50)

  users User[]
}

model User {
  user_id       Int      @id @default(autoincrement())
  email         String   @unique @db.VarChar(75)
  name          String   @db.VarChar(50)
  last_name     String   @db.VarChar(50)
  username      String   @unique @db.VarChar(70)
  password      String   @db.VarChar(255)
  role_id       Int
  register_date DateTime @default(now())

  role            Role              @relation(fields: [role_id], references: [role_id])
  visited_courses LastCourseVisit[]
}

model Teacher {
  teacher_id Int      @id @default(autoincrement())
  name       String   @db.VarChar(50)
  last_name  String   @db.VarChar(50)

  courses Course[]
}

// ==========================================
// Educational Module (Courses & Classes)
// ==========================================

model Course {
  course_id            Int      @id @default(autoincrement())
  name                 String   @db.VarChar(100)
  course_code          String   @unique @db.VarChar(10)
  url_image            String   @db.VarChar(255)
  description          String
  teacher_id           Int
  course_creation_date DateTime @default(now())
  update_date          DateTime @updatedAt

  teacher         Teacher           @relation(fields: [teacher_id], references: [teacher_id])
  classes         Class[]
  visiting_users  LastCourseVisit[]
}

// Cascade Delete: Deleting a User or Course automatically removes their visit history.
// Uniqueness: Restricts users to a single visit history record per course.
model LastCourseVisit {
  user_course_id  Int      @id @default(autoincrement())
  user_id         Int
  course_id       Int
  start_date      DateTime @default(now())
  last_visit_date DateTime @updatedAt

  user   User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  course Course @relation(fields: [course_id], references: [course_id], onDelete: Cascade)

  @@unique([user_id, course_id])
}

model Class {
  class_id            Int      @id @default(autoincrement())
  course_id           Int
  title               String   @db.VarChar(150)
  description         String
  url_youtube         String?  @db.VarChar(150)
  class_creation_date DateTime @default(now())

  course    Course     @relation(fields: [course_id], references: [course_id])
  materials Material[]
}

enum MaterialTypes {
  file
  link
  reference
}

// Cascade Delete: Deleting a Class automatically removes all its associated Material records.
model Material {
  material_id        Int      @id @default(autoincrement())
  class_id           Int
  material_type      MaterialTypes
  filename     String   @db.VarChar(150)
  file_path    String?  @db.VarChar(255)
  url_link         String?
  written_reference String?
  material_creation_date       DateTime @default(now())
  class              Class    @relation(fields: [class_id], references: [class_id], onDelete: Cascade)
}
