/// Defines the Prisma Client generator configuration.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

/// Configures the PostgreSQL database connection.
datasource db {
  provider = "postgresql"
}

// ==========================================
// User & Authentication Module
// ==========================================

/// Represents a system role (e.g., Admin, Student).
model Role {
  role_id   Int    @id @default(autoincrement())
  role_name String @unique @db.VarChar(50)

  users User[]
}

/// Core user entity containing authentication and profile data.
model User {
  user_id       Int      @id @default(autoincrement())
  email         String   @unique @db.VarChar(75)
  name          String   @db.VarChar(50)
  last_name     String   @db.VarChar(50)
  username      String   @unique @db.VarChar(70)
  password      String   @db.VarChar(255)
  role_id       Int
  register_date DateTime @default(now())

  role            Role              @relation(fields: [role_id], references: [role_id])
  visited_courses LastCourseVisit[]
}

/// Represents an instructor.
model Teacher {
  teacher_id Int      @id @default(autoincrement())
  name       String   @db.VarChar(50)
  last_name  String   @db.VarChar(50)

  courses Course[]
}

// ==========================================
// Educational Module (Courses & Classes)
// ==========================================

/// Represents an educational course.
model Course {
  course_id            Int      @id @default(autoincrement())
  name                 String   @db.VarChar(100)
  course_code          String   @unique @db.VarChar(10)
  url_image            String   @db.VarChar(255)
  description          String
  teacher_id           Int
  course_creation_date DateTime @default(now())
  update_date          DateTime @updatedAt

  teacher         Teacher           @relation(fields: [teacher_id], references: [teacher_id])
  classes         Class[]
  visiting_users  LastCourseVisit[]
}

/// Tracks the last time a user visited a specific course.
model LastCourseVisit {
  user_course_id  Int      @id @default(autoincrement())
  user_id         Int
  course_id       Int
  start_date      DateTime @default(now())
  last_visit_date DateTime @updatedAt

  user   User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  course Course @relation(fields: [course_id], references: [course_id], onDelete: Cascade)

  @@unique([user_id, course_id])
}

/// Represents a single lesson or module within a Course.
model Class {
  class_id            Int      @id @default(autoincrement())
  course_id           Int
  title               String   @db.VarChar(150)
  description         String
  url_youtube         String?  @db.VarChar(150)
  class_creation_date DateTime @default(now())

  course    Course     @relation(fields: [course_id], references: [course_id])
  materials Material[]
}

/// Defines the possible types of supplementary materials.
enum MaterialTypes {
  file
  link
  reference
}

/// Represents supplementary material (files, links, or text references) for a Class.
model Material {
  material_id            Int           @id @default(autoincrement())
  class_id               Int
  material_type          MaterialTypes
  filename               String        @db.VarChar(150)
  
  url_link               String?
  written_reference      String?
  material_creation_date DateTime      @default(now())

  class Class @relation(fields: [class_id], references: [class_id], onDelete: Cascade)
}

