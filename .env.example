# ==========================================
# UniOpenCourse — Variables de Entorno (Monorepo)
# Nota: En desarrollo local con npm workspaces, copia las variables correspondientes
# a apps/backend/.env y apps/frontend/.env respectivamente.
# ==========================================

# --- Compartidas (deben coincidir en Backend y Frontend) ---
JWT_SECRET="clave_super_secreta_para_jwt"

# --- Backend (apps/backend/.env) ---
PORT="3001"
FRONTEND_URL="http://localhost:3000"
DATABASE_URL="postgresql://uniopencourse_user:tu_contraseña@localhost:5432/uniopencourse"
STORAGE_PATH="./storage"

# Seed inicial de administrador
SEED_ADMIN_EMAIL="admin@test.com"
SEED_ADMIN_PASSWORD="tu_contraseña_segura"
SEED_ADMIN_USERNAME="admin"

# Correo transaccional (Brevo)
BREVO_API_KEY="xkeysib-tu-api-key"
MAIL_FROM="UniOpenCourse <tu-remitente-verificado@ejemplo.com>"
EMAIL_VERIFICATION_EXPIRES_HOURS="48"
EMAIL_RESEND_COOLDOWN_MINUTES="3"
BREVO_REQUEST_TIMEOUT_MS="15000"

# Almacenamiento en la nube (Cloudflare R2 - compatible con S3) con fallback local automático
# Si faltan credenciales o STORAGE_DRIVER="local", opera automáticamente en modo local (disco)
# STORAGE_DRIVER="r2"
R2_ACCOUNT_ID="tu_cloudflare_account_id"
R2_ACCESS_KEY_ID="tu_r2_access_key_id"
R2_SECRET_ACCESS_KEY="tu_r2_secret_access_key"
R2_BUCKET_NAME="uniopencourse-storage"
R2_PUBLIC_URL="https://pub-tu-id.r2.dev"

# --- Frontend (apps/frontend/.env) ---
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

